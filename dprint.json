{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "markdown": {
    "lineWidth": 80,
    "textWrap": "maintain",
    "newLineKind": "lf",
    "html.preferSingleLine": true,
    "codeBlock.raiseSyntaxErrors": false
  },
  "typescript": {
    "indentWidth": 2,
    "quoteStyle": "alwaysDouble",
    "semiColons": "always",
    "module.sortImportDeclarations": "caseInsensitive",
    "importDeclaration.sortNamedImports": "caseInsensitive"
  },
  "json": {
    "indentWidth": 2,
    "trailingCommas": "never"
  },
  "sql": {},
  "includes": ["**/*.md"],
  "excludes": ["**/node_modules", "**/dist", "website/{.docusaurus,build}"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    "https://plugins.dprint.dev/sql-0.3.0.wasm"
  ]
}
