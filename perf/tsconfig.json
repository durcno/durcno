{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig for more information */
    "target": "es2020" /* Specify ECMAScript target version */,
    "lib": ["es2022"],
    "module": "es2020",
    "moduleResolution": "bundler",
    "paths": {
      "durcno": ["../src/"],
      "durcno/connectors/pg": ["../src/connectors/pg"]
    },
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./*.ts"]
}
